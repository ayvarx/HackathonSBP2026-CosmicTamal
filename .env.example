# Copie este archivo como .env.local y complete los valores. NUNCA suba .env.local al repositorio.

# Cadena de conexión a Postgres (Supabase, "Session pooler").
# Si se deja vacía, la aplicación usa una base Postgres embebida (PGlite) en la carpeta .pgdata, sin internet.
DATABASE_URL=

# Secreto para firmar la cookie del perfil. Genere uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Asistente de IA (opcional). Sin esta clave la aplicación funciona igual y el asistente no aparece.
# La IA solo explica cifras ya calculadas por el motor; nunca calcula rankings.
ANTHROPIC_API_KEY=
